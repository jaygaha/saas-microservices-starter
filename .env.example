# Copy to .env and adjust. Real secrets belong ONLY in .env (git-ignored).
#
# EDGE / TRAEFIK
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# POSTGRESQL (shared)
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=saas_platform_db
POSTGRES_PORT=5432

# REDIS (shared)
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# APP / SECURITY
JWT_SECRET=change_me_to_a_long_random_string

# GO SERVICES (internal container ports)
AUTH_SERVICE_PORT=8000
TASK_SERVICE_PORT=8001

# WEB / BROWSER SERVICES (internal container ports · 3xxx)
FRONTEND_SERVICE_PORT=3000

# COMPOSE
COMPOSE_PROJECT_NAME=saas
